      "smtpEndpoint": "smtps://smtp.example.test",
      "credentialRef": "keychain:hermes-example/secondary",
      "sentPolicy": "provider_managed",
      "enabled": true,
      "allowedSender": "secondary@example.test",
      "allowedAttachmentRoots": [
        "/var/lib/hermes-mail-gateway-example/attachments"
      ],
      "inboxFolder": "INBOX",
      "sentFolder": "Sent"
